# Requires the existing UniHub Authentik outpost on 127.0.0.1:9000.
# Keep this secret outside Git in /etc/nginx/snippets/unihub-insight-secret.conf:
#   set $unihub_insight_proxy_secret "same value as UNIHUB_INSIGHT_TRUSTED_PROXY_SECRET";

server {
    listen 443 ssl http2;
    server_name insight.unihub.ro;

    root /opt/unihub-insight/current/apps/web/dist;
    index index.html;

    # Replace with the certificates already managed for the UniHub environment.
    ssl_certificate /etc/letsencrypt/live/insight.unihub.ro/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/insight.unihub.ro/privkey.pem;
    include /etc/nginx/snippets/unihub-insight-secret.conf;

    location = /outpost.goauthentik.io/auth/nginx {
        internal;
        auth_request off;
        proxy_pass http://127.0.0.1:9000/outpost.goauthentik.io/auth/nginx;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header X-Original-URL $scheme://$http_host$request_uri;
        proxy_set_header Host $host;
    }

    location /outpost.goauthentik.io/ {
        auth_request off;
        proxy_pass http://127.0.0.1:9000/outpost.goauthentik.io/;
        proxy_set_header Host $host;
        proxy_set_header X-Original-URL $scheme://$http_host$request_uri;
    }

    location @goauthentik_proxy_signin {
        auth_request off;
        return 302 /outpost.goauthentik.io/start?rd=$scheme://$http_host$request_uri;
    }

    auth_request /outpost.goauthentik.io/auth/nginx;
    error_page 401 = @goauthentik_proxy_signin;
    auth_request_set $authentik_uid $upstream_http_x_authentik_uid;
    auth_request_set $authentik_email $upstream_http_x_authentik_email;
    auth_request_set $authentik_name $upstream_http_x_authentik_name;
    auth_request_set $authentik_groups $upstream_http_x_authentik_groups;

    location /api/ {
        proxy_pass http://127.0.0.1:8100;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Authentik-Uid $authentik_uid;
        proxy_set_header X-Authentik-Email $authentik_email;
        proxy_set_header X-Authentik-Name $authentik_name;
        proxy_set_header X-Authentik-Groups $authentik_groups;
        proxy_set_header X-UniHub-Proxy-Secret $unihub_insight_proxy_secret;
        proxy_read_timeout 10s;
        proxy_send_timeout 10s;
        proxy_connect_timeout 3s;
    }

    location = /readyz {
        auth_request off;
        proxy_pass http://127.0.0.1:8100/readyz;
        allow 127.0.0.1;
        deny all;
    }

    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-store" always;
    }

    location ~* \.(?:js|css|woff2|png|svg)$ {
        try_files $uri =404;
        expires 1y;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }
}
