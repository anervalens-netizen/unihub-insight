-- Run once as the authenticated owner of database unihub. This bootstrap is
-- intentionally explicit: it creates no broad/default grants and no LOGIN
-- principal receives object ownership or direct object ACLs.
--
-- Replace only the three LOGIN password placeholders through the approved
-- credential channel; never put a real value in this file or shell history.

-- Authority and ownership are separate from process identities, matching the
-- Retail database contract. The migration marker has no object privileges;
-- its runner SET LOCAL ROLE to the schema owner for checksum-controlled DDL.
CREATE ROLE unihub_insight_reader
    NOLOGIN NOSUPERUSER NOCREATEDB NOCREATEROLE NOINHERIT NOBYPASSRLS NOREPLICATION;
CREATE ROLE unihub_insight_metadata
    NOLOGIN NOSUPERUSER NOCREATEDB NOCREATEROLE NOINHERIT NOBYPASSRLS NOREPLICATION;
CREATE ROLE unihub_insight_migrator
    NOLOGIN NOSUPERUSER NOCREATEDB NOCREATEROLE NOINHERIT NOBYPASSRLS NOREPLICATION;
CREATE ROLE unihub_insight_schema_owner
    NOLOGIN NOSUPERUSER NOCREATEDB NOCREATEROLE NOINHERIT NOBYPASSRLS NOREPLICATION;

-- Refuse to take over a schema belonging to another application. The database
-- owner precreates Insight's isolated schema before its migration runner starts.
DO $$
DECLARE
    existing_owner TEXT;
BEGIN
    SELECT owner.rolname
      INTO existing_owner
      FROM pg_namespace AS namespace
      JOIN pg_roles AS owner ON owner.oid = namespace.nspowner
     WHERE namespace.nspname = 'insight';

    IF existing_owner IS NULL THEN
        CREATE SCHEMA insight AUTHORIZATION unihub_insight_schema_owner;
    ELSIF existing_owner <> 'unihub_insight_schema_owner' THEN
        RAISE EXCEPTION
            'schema insight already exists with unexpected owner %', existing_owner;
    END IF;
END
$$;

REVOKE ALL ON SCHEMA insight FROM PUBLIC;

GRANT CONNECT ON DATABASE unihub TO
    unihub_insight_reader,
    unihub_insight_metadata,
    unihub_insight_migrator;
-- Retail owns the database-wide PUBLIC TEMPORARY posture. This template does
-- not alter it because Insight must not broaden a cross-application fence.

-- Read-only Retail analytical surface. New Retail objects remain denied until
-- their business contract is reviewed and added explicitly.
GRANT USAGE ON SCHEMA public TO unihub_insight_reader;
GRANT SELECT ON TABLE
    reporting_agent_day,
    reporting_agent_month,
    reporting_item_month,
    reporting_category_month,
    reporting_focus_item_month,
    reporting_agent_profile,
    reporting_agent_lifecycle_month,
    reporting_source_snapshot_v1,
    reporting_source_snapshot_v2,
    reporting_source_snapshot_v3,
    reporting_sales_day_v1,
    reporting_campaign_month_v1,
    reporting_workforce_month_v1,
    reporting_compensation_month_v1,
    reporting_visit_month_v1,
    reporting_visit_month_v2,
    reporting_finance_month_v1,
    reporting_planning_scenario_v1,
    reporting_planning_scenario_v2,
    store_targets,
    agent_targets,
    stores,
    grile_store_current_status
TO unihub_insight_reader;

-- Fail closed if an older rollout granted the Insight authority any raw
-- source used behind the approved reporting views. View owners retain the
-- minimum underlying access; the API reader never receives it directly.
DO $deny_raw_sources$
DECLARE
    raw_source TEXT;
BEGIN
    FOREACH raw_source IN ARRAY ARRAY[
        'sales_transactions',
        'import_snapshots',
        'sales_generation_heads',
        'salary_records',
        'salary_import_batches',
        'agent_salary_links',
        'visits_snapshot',
        'fieldops_visits',
        'store_pnl_monthly',
        'store_pnl_generations',
        'store_pnl_generation_heads',
        'store_pnl_generation_scopes',
        'store_pnl_generation_rows',
        'store_pnl_site_links',
        'ai_forecast_runs',
        'ai_forecast_store_month',
        'target_scenarios',
        'target_scenario_rows'
    ]
    LOOP
        IF to_regclass(format('public.%I', raw_source)) IS NOT NULL THEN
            EXECUTE format(
                'REVOKE ALL PRIVILEGES ON TABLE public.%I FROM unihub_insight_reader',
                raw_source
            );
        END IF;
    END LOOP;
END
$deny_raw_sources$;

-- The governed product/month view is owned by Insight. Its owner needs only
-- the source columns used in the view, never access to Retail's public schema
-- DDL surface. The reader gets the view in migration 002, not raw sales rows.
GRANT USAGE ON SCHEMA public TO unihub_insight_schema_owner;
GRANT SELECT (
    import_month, site_code, agent, item_code, item_name, brand, category,
    total_value, quantity, is_cartela, is_return
) ON TABLE sales_transactions TO unihub_insight_schema_owner;

-- Each runtime process authenticates as a distinct LOGIN. It inherits exactly
-- one non-owner authority; no LOGIN receives a direct object grant or owns an
-- object. The migration runner is NOINHERIT and may SET only the isolated
-- Insight schema owner during a migration transaction.
CREATE ROLE unihub_insight_api_reader
    LOGIN INHERIT NOSUPERUSER NOCREATEDB NOCREATEROLE NOBYPASSRLS NOREPLICATION
    PASSWORD 'REPLACE_READER_PASSWORD';
ALTER ROLE unihub_insight_api_reader SET default_transaction_read_only = on;
ALTER ROLE unihub_insight_api_reader SET statement_timeout = '2500ms';
ALTER ROLE unihub_insight_api_reader SET lock_timeout = '1000ms';

CREATE ROLE unihub_insight_api_metadata
    LOGIN INHERIT NOSUPERUSER NOCREATEDB NOCREATEROLE NOBYPASSRLS NOREPLICATION
    PASSWORD 'REPLACE_METADATA_PASSWORD';
ALTER ROLE unihub_insight_api_metadata SET statement_timeout = '2500ms';
ALTER ROLE unihub_insight_api_metadata SET lock_timeout = '1000ms';

CREATE ROLE unihub_insight_migration_runner
    LOGIN NOINHERIT NOSUPERUSER NOCREATEDB NOCREATEROLE NOBYPASSRLS NOREPLICATION
    PASSWORD 'REPLACE_MIGRATOR_PASSWORD';
ALTER ROLE unihub_insight_migration_runner SET statement_timeout = '30s';
ALTER ROLE unihub_insight_migration_runner SET lock_timeout = '5s';

-- The runner is NOINHERIT, so it needs direct CONNECT before SET LOCAL ROLE.
-- This is its only direct database ACL; it has no direct object/schema grants
-- and cannot inherit the migration marker's privileges.
GRANT CONNECT ON DATABASE unihub TO unihub_insight_migration_runner;

GRANT unihub_insight_reader TO unihub_insight_api_reader
    WITH INHERIT TRUE, SET FALSE;
GRANT unihub_insight_metadata TO unihub_insight_api_metadata
    WITH INHERIT TRUE, SET FALSE;
GRANT unihub_insight_migrator TO unihub_insight_migration_runner
    WITH INHERIT FALSE, SET FALSE;
GRANT unihub_insight_schema_owner TO unihub_insight_migration_runner
    WITH INHERIT FALSE, SET TRUE;
