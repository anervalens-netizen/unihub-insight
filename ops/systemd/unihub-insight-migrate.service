[Unit]
Description=UniHub Insight metadata migrations
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
User=unihub-insight
Group=unihub-insight
WorkingDirectory=/opt/unihub-insight/current
EnvironmentFile=/etc/unihub-insight/migration.env
ExecStartPre=/bin/bash -c 'for attempt in {1..45}; do (echo >/dev/tcp/127.0.0.1/5432) >/dev/null 2>&1 && exit 0; sleep 2; done; exit 1'
ExecStart=/opt/unihub-insight/current/apps/api/.venv/bin/python ops/scripts/migrate.py
RemainAfterExit=no
TimeoutStartSec=90
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
UMask=0027
TasksMax=64
MemoryMax=384M
